{
  "manifest_version": 3,
  "name": "Sidebit",
  "version": "1.22.0",
  "description": "Always-on side panel for quick notes, one-click quick-copy snippets, and saving highlighted text from any page.",
  "permissions": ["storage", "sidePanel", "unlimitedStorage", "downloads", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Sidebit"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
