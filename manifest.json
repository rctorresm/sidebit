{
  "manifest_version": 3,
  "name": "NoteDock",
  "version": "1.2.0",
  "description": "Always-on side panel for quick notes, one-click quick-copy snippets, and saving highlighted text from any page.",
  "permissions": ["storage", "sidePanel", "unlimitedStorage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open NoteDock"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
